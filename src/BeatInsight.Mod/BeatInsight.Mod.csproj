<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>BeatInsight</AssemblyName>
    <RootNamespace>BeatInsight.Mod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BeatInsight.Core/BeatInsight.Core.csproj" />
    <ProjectReference Include="../BeatInsight.Formats/BeatInsight.Formats.csproj" />
    <Reference Include="IPA.Loader" HintPath="$(GameRoot)/Beat Saber_Data/Managed/IPA.Loader.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameRoot)/Libs/0Harmony.dll" Private="false" />
    <Reference Include="Main" HintPath="$(GameRoot)/Beat Saber_Data/Managed/Main.dll" Private="false" />
    <Reference Include="DataModels" HintPath="$(GameRoot)/Beat Saber_Data/Managed/DataModels.dll" Private="false" />
    <Reference Include="AdditionalContentModel.Interfaces" HintPath="$(GameRoot)/Beat Saber_Data/Managed/AdditionalContentModel.Interfaces.dll" Private="false" />
    <Reference Include="GameplayCore" HintPath="$(GameRoot)/Beat Saber_Data/Managed/GameplayCore.dll" Private="false" />
    <Reference Include="BeatmapCore" HintPath="$(GameRoot)/Beat Saber_Data/Managed/BeatmapCore.dll" Private="false" />
    <Reference Include="BGLib.UnityExtension" HintPath="$(GameRoot)/Beat Saber_Data/Managed/BGLib.UnityExtension.dll" Private="false" />
    <Reference Include="HMUI" HintPath="$(GameRoot)/Beat Saber_Data/Managed/HMUI.dll" Private="false" />
    <Reference Include="BeatSaber.ViewSystem" HintPath="$(GameRoot)/Beat Saber_Data/Managed/BeatSaber.ViewSystem.dll" Private="false" />
    <Reference Include="Colors" HintPath="$(GameRoot)/Beat Saber_Data/Managed/Colors.dll" Private="false" />
    <Reference Include="BSML" HintPath="$(GameRoot)/Plugins/BSML.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameRoot)/Beat Saber_Data/Managed/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.PhysicsModule.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- The game resolves these dependencies. Avoid recursively resolving its
         unrelated framework assemblies against the build machine's references. -->
    <Reference Update="@(Reference)" ExternallyResolved="true" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="manifest.json" /><EmbeddedResource Include="Settings.bsml" /></ItemGroup>
  <Target Name="ValidateGameDependencies" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameRoot)' == ''" Text="Configure GameRoot in paths.props or BEATINSIGHT_GAME_ROOT." />
    <Error Condition="!Exists('$(GameRoot)/Beat Saber_Data/Managed/IPA.Loader.dll')" Text="Configured game has no BSIPA loader." />
  </Target>
</Project>
