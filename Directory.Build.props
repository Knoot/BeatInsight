<Project>
  <PropertyGroup>
    <GameRoot Condition="'$(GameRoot)' == ''">$(BEATINSIGHT_GAME_ROOT)</GameRoot>
    <CecilPath Condition="'$(CecilPath)' == ''">$(BEATINSIGHT_CECIL_PATH)</CecilPath>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == '' and '$(NUGET_PACKAGES)' != ''">$(NUGET_PACKAGES)/</NuGetPackageRoot>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)paths.props" Condition="Exists('$(MSBuildThisFileDirectory)paths.props')" />
  <PropertyGroup>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == '' and '$(NUGET_PACKAGES)' != ''">$(NUGET_PACKAGES)/</NuGetPackageRoot>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == ''">$(UserProfile)/.nuget/packages/</NuGetPackageRoot>
    <CecilPath Condition="'$(CecilPath)' == ''">$(NuGetPackageRoot)mono.cecil/0.11.6/lib/netstandard2.0/Mono.Cecil.dll</CecilPath>
  </PropertyGroup>
</Project>
